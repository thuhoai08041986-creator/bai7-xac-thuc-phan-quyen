@inject LanguageService L
@{var tr=new Func<string,string>(k=>L.T(Context,k)); var current=Context.Request.Path+Context.Request.QueryString.ToString();}
<!doctype html><html lang="@L.Lang(Context)"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@tr("App") · BIT240098</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" asp-append-version="true" href="~/css/site.css"/></head><body>
<nav class="navbar navbar-expand-lg navbar-dark main-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🍽️ @tr("App")</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="navMain"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-3"><a class="nav-link" asp-controller="Home" asp-action="Index">@tr("Home")</a><a class="nav-link" asp-controller="Dishes" asp-action="Index">@tr("Dishes")</a><a class="nav-link" asp-controller="DishCategories" asp-action="Index">@tr("Categories")</a><a class="btn btn-sm btn-warning" asp-controller="AuthPage" asp-action="Login">Đăng nhập JWT</a><form asp-controller="Language" asp-action="Change" method="post" class="d-flex gap-1 my-2 my-lg-0"><input type="hidden" name="returnUrl" value="@current"/><button type="submit" class="btn btn-sm @(L.Lang(Context)=="en"?"btn-warning":"btn-outline-light")" name="lang" value="en">EN</button><button type="submit" class="btn btn-sm @(L.Lang(Context)=="vi"?"btn-warning":"btn-outline-light")" name="lang" value="vi">VI</button></form></div></div></div></nav>
<main class="container py-4">@if(TempData["Notice"] is string n){<div class="alert alert-success" role="alert">@tr(n)</div>}@if(TempData["Error"] is string e){<div class="alert alert-danger" role="alert">@tr(e)</div>}@RenderBody()</main><footer class="container text-center text-muted small py-4">BIT240098 · ASP.NET Core MVC · SQL Server</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
