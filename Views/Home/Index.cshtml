@model HomeViewModel
@inject LanguageService L
@{ var t=new Func<string,string>(k=>L.T(Context,k)); }
<section class="hero-panel mb-4"><div class="row align-items-center g-4"><div class="col-lg-8"><span class="eyebrow">BIT240098 · ASP.NET Core MVC</span><h1 class="display-5 fw-bold mt-2">@t("Dashboard")</h1><p class="lead opacity-75">@t("Welcome")</p><div class="d-flex gap-2 flex-wrap"><a asp-controller="Dishes" asp-action="Index" class="btn btn-light">@t("ViewAll") →</a><a asp-controller="Dishes" asp-action="Create" class="btn btn-outline-light">+ @t("Create")</a><a asp-controller="DishCategories" asp-action="Index" class="btn btn-outline-light">@t("ManageCategories")</a></div></div><div class="col-lg-4 d-none d-lg-flex justify-content-center"><div class="hero-emoji">🍜</div></div></div></section>
<div class="row g-3 mb-4">
@foreach(var stat in new[]{(t("TotalDishes"),Model.TotalDishes,"🍽️"),(t("ActiveDishes"),Model.ActiveDishes,"✅"),(t("InactiveDishes"),Model.InactiveDishes,"⏸️"),(t("TotalCategories"),Model.TotalCategories,"📚")}){<div class="col-6 col-lg-3"><div class="card shadow-sm h-100 stat-card"><div class="card-body"><div class="d-flex justify-content-between"><span class="text-muted">@stat.Item1</span><span>@stat.Item3</span></div><div class="fs-2 fw-bold mt-2">@stat.Item2</div></div></div></div>}
</div>
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 m-0">@t("Featured")</h2><a asp-controller="Dishes" asp-action="Index">@t("ViewAll") →</a></div>
@if(!Model.Latest.Any()){<div class="alert alert-info">@t("NoResults")</div>}
else{<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">@foreach(var d in Model.Latest){var img=d.Images.FirstOrDefault(x=>x.IsThumbnail)??d.Images.FirstOrDefault();<div class="col"><div class="card h-100 shadow-sm dish-card">@if(img!=null){<img src="@img.ImageUrl" alt="@d.Name" class="card-img-top food-cover"/>}else{<div class="food-cover placeholder-cover">🍲 @t("NoImage")</div>}<div class="card-body"><div class="d-flex justify-content-between gap-2"><h5>@d.Name</h5><span class="badge align-self-start @(d.IsAvailable?"bg-success":"bg-secondary")">@(d.IsAvailable?t("Available"):t("Unavailable"))</span></div><p class="text-muted small">@d.DishCategory?.Name</p><div class="d-flex justify-content-between align-items-center"><strong class="price">@d.Price.ToString("N0") ₫</strong><span class="small">@d.PreparationTime @t("Minutes") · @(d.PreparationTime<=15?t("Quick"):t("Regular"))</span></div></div><div class="card-footer bg-white border-0 pb-3"><a asp-controller="Dishes" asp-action="Details" asp-route-id="@d.Id" class="btn btn-outline-primary btn-sm">@t("Details") →</a></div></div></div>}</div>}
