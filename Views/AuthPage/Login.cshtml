@{ ViewData["Title"]="JWT Login"; }
<div class="card mx-auto p-4" style="max-width:580px"><h2>Đăng nhập JWT</h2><p>Nhập tài khoản User hoặc Admin đã tạo trong SQL Server.</p>
<form id="loginForm"><label class="form-label">Tài khoản</label><input id="username" class="form-control mb-3" required autocomplete="username"/><label class="form-label">Mật khẩu</label><input id="password" type="password" class="form-control mb-3" required autocomplete="current-password"/><button class="btn btn-primary" type="submit">Đăng nhập</button> <button class="btn btn-outline-secondary" id="logout" type="button">Đăng xuất</button></form>
<p id="status" class="mt-3" role="status"></p><div class="d-flex flex-wrap gap-2"><button class="btn btn-outline-primary" id="me" type="button">API /me</button><button class="btn btn-outline-success" id="user" type="button">API User</button><button class="btn btn-outline-danger" id="admin" type="button">API Admin</button></div><pre class="mt-3 p-3 bg-light" id="result" style="white-space:pre-wrap"></pre></div>
@section Scripts {<script src="~/js/jwt-login.js" asp-append-version="true"></script>}
