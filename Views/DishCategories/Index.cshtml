@model List<DishManagement_BIT240098.Controllers.DishCategoriesController.CategoryRow>
@inject LanguageService L
@{var t=new Func<string,string>(k=>L.T(Context,k));}
<h2>@t("Categories")</h2><form asp-action="Create" method="post" class="card card-body mb-4"><h5>@t("CreateCategory")</h5><div class="row g-2"><div class="col-md-5"><input class="form-control" name="Name" required placeholder="@t("Name")"/></div><div class="col-md-5"><input class="form-control" name="Description" placeholder="@t("Description")"/></div><div class="col-md-2"><button class="btn btn-primary w-100">@t("Save")</button></div></div></form>
<table class="table table-striped"><thead><tr><th>@t("Name")</th><th>@t("Description")</th><th>@t("Dishes")</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td colspan="4"><div class="d-flex flex-wrap gap-2 align-items-center"><form asp-action="Edit" asp-route-id="@c.Id" method="post" class="d-flex flex-grow-1 gap-2"><input class="form-control" name="name" value="@c.Name" required/><input class="form-control" name="description" value="@c.Description"/><span class="align-self-center">@c.Count</span><button class="btn btn-outline-primary btn-sm">@t("Save")</button></form><form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('@t("ConfirmDelete")')"><button class="btn btn-outline-danger btn-sm">@t("Delete")</button></form></div></td></tr>}</tbody></table>
