@model Dish_BIT240098
@inject LanguageService L
@{ var t=new Func<string,string>(k=>L.T(Context,k)); }
<div class="d-flex justify-content-between"><h2>@t("Details"): @Model.Name</h2><a asp-action="Index" class="btn btn-outline-secondary">@t("Back")</a></div><div class="card card-body my-3"><p><b>@t("Category"):</b> @Model.DishCategory?.Name</p><p><b>@t("Price"):</b> @Model.Price.ToString("N0") ₫</p><p><b>@t("Time"):</b> @Model.PreparationTime min — @(Model.PreparationTime<=15?t("Quick"):t("Regular"))</p><p><b>@t("Availability"):</b> @(Model.IsAvailable?t("Available"):t("Unavailable"))</p><p>@Model.Description</p><div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@t("Edit")</a><form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('@t("ConfirmDelete")')"><button class="btn btn-danger">@t("Delete")</button></form></div></div>
<h4>@t("Images")</h4><div class="row g-3 mb-3">@if(!Model.Images.Any()){<p>@t("NoImage")</p>}@foreach(var img in Model.Images.OrderByDescending(x=>x.IsThumbnail).ThenBy(x=>x.Id)){<div class="col-md-4"><div class="card"><img src="@img.ImageUrl" class="card-img-top food-cover" alt="@Model.Name"/><div class="card-body">@if(img.IsThumbnail){<span class="badge bg-success">@t("Thumbnail")</span>}<div class="d-flex gap-2 mt-2">@if(!img.IsThumbnail){<form asp-controller="DishImages" asp-action="SetThumbnail" asp-route-id="@img.Id" method="post"><button class="btn btn-outline-primary btn-sm">@t("Thumbnail")</button></form>}<form asp-controller="DishImages" asp-action="Delete" asp-route-id="@img.Id" method="post" onsubmit="return confirm('@t("ConfirmDelete")')"><button class="btn btn-outline-danger btn-sm">@t("RemoveImage")</button></form></div></div></div></div>}</div>
<form asp-controller="DishImages" asp-action="Create" method="post" class="card card-body"><h5>@t("AddImage")</h5><input type="hidden" name="dishId" value="@Model.Id"/><label>@t("ImageUrl")</label><input class="form-control mb-2" type="url" name="imageUrl" placeholder="https://example.com/food.jpg" required/><label class="mb-2"><input type="checkbox" name="isThumbnail" value="true"/> @t("Thumbnail")</label><button class="btn btn-primary">@t("AddImage")</button></form>
