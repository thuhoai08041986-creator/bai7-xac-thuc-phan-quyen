@model DishFilterViewModel
@inject LanguageService L
@{ var t = new Func<string,string>(k=>L.T(Context,k)); }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@t("Dishes")</h2><a class="btn btn-primary" asp-action="Create">+ @t("Create")</a></div>
<form method="get" class="card card-body mb-4"><div class="row g-2"><div class="col-md-4"><label>@t("Search")</label><input class="form-control" name="Search" value="@Model.Search" placeholder="@t("Search")"/></div><div class="col-md-4"><label>@t("Category")</label><select class="form-select" name="CategoryId"><option value="">@t("All")</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId==c.Id)">@c.Name</option>}</select></div><div class="col-md-4"><label>@t("Availability")</label><select class="form-select" name="Availability"><option value="">@t("All")</option><option value="available" selected="@(Model.Availability=="available")">@t("Available")</option><option value="unavailable" selected="@(Model.Availability=="unavailable")">@t("Unavailable")</option></select></div><div class="col-md-3"><label>@t("MinPrice")</label><input type="number" min="0" step="0.01" class="form-control" name="MinPrice" value="@Model.MinPrice"/></div><div class="col-md-3"><label>@t("MaxPrice")</label><input type="number" min="0" step="0.01" class="form-control" name="MaxPrice" value="@Model.MaxPrice"/></div><div class="col-md-4"><label>@t("Sort")</label><select name="Sort" class="form-select"><option value="">@t("All")</option><option value="price_asc" selected="@(Model.Sort=="price_asc")">@t("PriceAsc")</option><option value="price_desc" selected="@(Model.Sort=="price_desc")">@t("PriceDesc")</option><option value="time_asc" selected="@(Model.Sort=="time_asc")">@t("TimeAsc")</option></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">@t("Filter")</button></div></div><div class="mt-2"><a asp-action="Index">@t("Clear")</a><div class="text-danger" asp-validation-summary="All"></div></div></form>
@if(!Model.Dishes.Any()){<div class="alert alert-info">@t("NoResults")</div>}else{<div class="row row-cols-1 row-cols-md-3 g-3">@foreach(var d in Model.Dishes){var thumb=d.Images.FirstOrDefault(x=>x.IsThumbnail)??d.Images.FirstOrDefault();<div class="col"><div class="card h-100 shadow-sm">@if(thumb!=null){<img class="card-img-top food-cover" src="@thumb.ImageUrl" alt="@d.Name"/>}else{<div class="food-cover placeholder-cover">@t("NoImage")</div>}<div class="card-body"><h5>@d.Name</h5><p class="text-muted">@d.DishCategory?.Name</p><p class="fw-bold">@d.Price.ToString("N0") ₫</p><p>@d.PreparationTime min · <span class="badge bg-info text-dark">@(d.PreparationTime<=15?t("Quick"):t("Regular"))</span></p><span class="badge @(d.IsAvailable?"bg-success":"bg-secondary")">@(d.IsAvailable?t("Available"):t("Unavailable"))</span></div><div class="card-footer bg-white"><a asp-action="Details" asp-route-id="@d.Id" class="btn btn-outline-primary btn-sm">@t("Details")</a><a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-outline-secondary btn-sm">@t("Edit")</a></div></div></div>}</div>}
