@model Dish_BIT240098
@inject LanguageService L
@{ var t=new Func<string,string>(k=>L.T(Context,k)); var editing=ViewContext.RouteData.Values["action"]?.ToString()=="Edit"; }
<h2>@(editing?t("Edit"):t("Create"))</h2><form method="post" asp-action="@(editing?"Edit":"Create")" asp-route-id="@(editing?Model.Id:null)" class="card card-body"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label class="form-label">@t("Name")</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="row"><div class="col-md-6 mb-3"><label>@t("Price")</label><input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control"/><span asp-validation-for="Price" class="text-danger"></span></div><div class="col-md-6 mb-3"><label>@t("Time")</label><input asp-for="PreparationTime" type="number" min="1" class="form-control"/><span asp-validation-for="PreparationTime" class="text-danger"></span></div></div><div class="mb-3"><label>@t("Category")</label><select asp-for="DishCategoryId" asp-items="ViewBag.CategoryOptions" class="form-select"><option value="0">@t("Select")</option></select><span asp-validation-for="DishCategoryId" class="text-danger"></span></div><div class="mb-3"><label>@t("Description")</label><textarea asp-for="Description" class="form-control"></textarea></div><div class="form-check mb-3"><input asp-for="IsAvailable" class="form-check-input"/><label class="form-check-label">@t("Available")</label></div><div class="card bg-light border-0 p-3 mb-3">
<h5>@t("AddImage") — ImageUrl</h5>
<p class="text-muted small">@t("ImageFormHelp")</p>
<textarea id="imageUrls" name="imageUrls" rows="4" class="form-control mb-2" placeholder="https://example.com/pho.jpg&#10;https://example.com/pho-2.jpg">@ViewBag.ImageUrls</textarea>
<div class="text-danger">@Html.ValidationMessage("imageUrls")</div>
<label for="thumbnailIndex" class="form-label">@t("ThumbnailNumber")</label>
<input id="thumbnailIndex" name="thumbnailIndexDisplay" type="number" min="1" value="@((ViewBag.ThumbnailIndex is int i ? i : 0)+1)" class="form-control" style="max-width:140px" />
<input type="hidden" id="thumbnailIndex" name="thumbnailIndex" value="@(ViewBag.ThumbnailIndex ?? 0)" /><div class="form-text">@t("ThumbnailNumberHelp")</div>
</div>
<div><button class="btn btn-primary">@t("Save")</button><a asp-action="Index" class="btn btn-secondary">@t("Cancel")</a></div></form>
@section Scripts{<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script><script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script><script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script><script>document.querySelectorAll('[data-val-required]').forEach(e=>e.setAttribute('data-val-required',@Html.Raw(System.Text.Json.JsonSerializer.Serialize(t("Required")))));document.querySelectorAll('[data-val-range]').forEach(e=>e.setAttribute('data-val-range',@Html.Raw(System.Text.Json.JsonSerializer.Serialize(t("Positive")))));document.querySelector('form').addEventListener('submit',function(){let n=parseInt(document.querySelector('[name=thumbnailIndexDisplay]').value,10);document.getElementById('thumbnailIndex').value=Number.isFinite(n)?n-1:0;});if(window.jQuery){$('form').removeData('validator').removeData('unobtrusiveValidation');$.validator.unobtrusive.parse('form');}</script>}
